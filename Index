  #preloader{
    position:fixed; inset:0; z-index:3000;
    background: var(--preto);
    display:flex; align-items:center; justify-content:center;
    transition: opacity 0.7s ease, visibility 0.7s ease;
    animation: preloaderFallback 0.6s ease forwards;
    animation-delay: 2s;
  }
  @keyframes preloaderFallback{ to{ opacity:0; visibility:hidden; pointer-events:none; } }
  #preloader.escondido{ opacity:0; visibility:hidden; pointer-events:none; }
  .preloader-logo{ text-align:center; font-family: var(--display); font-size:1.9rem; color: var(--texto-claro); opacity:0; animation: logoSurge 1.6s ease forwards; }
