  .lightbox-fechar{ position:absolute; top:20px; right:24px; color: var(--texto-claro); font-size:2.1rem; line-height:1; transition: color 0.25s ease, transform 0.25s ease; }
  .lightbox-fechar:hover{ color: var(--dourado-claro); transform: rotate(90deg); }

  /* ---------- WhatsApp flutuante ---------- */
  .whatsapp-float{ position:fixed; bottom:22px; right:22px; z-index:999; background:#25D366; width:60px; height:60px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 10px 26px rgba(0,0,0,0.35); transition: transform 0.25s ease; }
